# Local development uses Vite's /api proxy automatically.
# In production, serve this path through a same-origin reverse proxy to the API,
# or enable CORS for the deployed frontend origin on the backend.
VITE_API_BASE_URL=/api

# Google OAuth Configuration
# Get your Client ID from Google Cloud Console: https://console.cloud.google.com/
# Instructions:
# 1. Create a new OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URIs (e.g., http://localhost:5173 for dev, your production URL)
# 3. Copy the Client ID and paste it below
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
