# Google OAuth Configuration
# Get your Client ID from Google Cloud Console: https://console.cloud.google.com/
# 
# SETUP INSTRUCTIONS:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Navigate to "APIs & Services" → "Credentials"
# 4. Click "Create Credentials" → "OAuth Client ID"
# 5. Choose "Web application"
# 6. Add authorized redirect URIs:
#    - http://localhost:5173 (local dev)
#    - http://localhost:5174 (local dev alternative)
#    - http://localhost:5175 (local dev alternative)
#    - https://yourproductiondomain.com (production)
# 7. Copy the Client ID and paste it below:

VITE_GOOGLE_CLIENT_ID=1025336081994-87q8c2iu6a6a1ngcua183pkfk8qbkhi6.apps.googleusercontent.com

# Backend API Configuration
# For local development, use localhost to avoid CORS issues
VITE_API_BASE_URL=http://localhost:3000
